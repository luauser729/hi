-- ⚡ 自动页
-- =========================================================
local atmFarmEn = false
local atmFarmSpd = 0.15
local atmAttackCount = 6
local atmCooldown = 0.5

TabAuto:Section({ Title = "🏦 ATM 全自动打劫" })
TabAuto:Paragraph({ Title = "⚠️ 说明", Desc = "自动装备拳头，精准传送到吐钱口正前方。攻击时实时锁定角色和视角，绝对不空刀。" })

TabAuto:Slider({ Title = "攻击速度 (秒)", Value = { Min = 0.05, Max = 2, Default = 0.15 }, Callback = function(v) atmFarmSpd = v end })
TabAuto:Slider({ Title = "每个 ATM 攻击次数", Value = { Min = 1, Max = 20, Default = 6 }, Callback = function(v) atmAttackCount = v end })
TabAuto:Slider({ Title = "传送冷却 (秒)", Value = { Min = 0.1, Max = 5, Default = 0.5 }, Callback = function(v) atmCooldown = v end })

TabAuto:Toggle({ Title = "开启 ATM 全自动打劫", Value = false, Callback = function(en)
    atmFarmEn = en
    if en then
        task.spawn(function()
            while atmFarmEn do
                local targetATMs = {}
                pcall(function()
                    for _, obj in ipairs(workspace:GetDescendants()) do
                        local n = string.lower(obj.Name)
                        if (obj:IsA("Model") and n == "atm") or (obj:IsA("BasePart") and n == "atm") then
                            local part = obj:IsA("Model") and (obj.PrimaryPart or obj:FindFirstChildWhichIsA("BasePart")) or obj
                            if part then table.insert(targetATMs, part) end
                        end
                    end
                end)

                for _, atmPart in ipairs(targetATMs) do
                    if not atmFarmEn then break end
                    local char = LocalPlayer.Character
                    local hrp = char and char:FindFirstChild("HumanoidRootPart")
                    
                    if hrp then
                        -- 自动装备
                        pcall(function()
                            local bp = LocalPlayer:FindFirstChildOfClass("Backpack")
                            if bp then
                                local bestTool = nil
                                for _, tool in ipairs(bp:GetChildren()) do
                                    if tool:IsA("Tool") then
                                        local name = string.lower(tool.Name)
                                        if name:find("fist") or name:find("拳") or name:find("hand") then
                                            bestTool = tool; break
                                        end
                                    end
                                end
                                if bestTool then
                                    local hum = char:FindFirstChildOfClass("Humanoid")
                                    if hum then hum:EquipTool(bestTool) end
                                end
                            end
                        end)

                        -- 精准传送并锁定朝向
                        local atmPos = atmPart.Position
                        local atmLook = atmPart.CFrame.LookVector
                        local standPos = atmPos + (atmLook * 2.5) + Vector3.new(0, 1.5, 0)
                        
                        hrp.CFrame = CFrame.new(standPos, atmPos)
                        Camera.CFrame = CFrame.new(Camera.CFrame.Position, atmPos)

                        -- 模拟点击攻击
                        for i = 1, atmAttackCount do
                            if not atmFarmEn then break end
                            pcall(function()
                                local curChar = LocalPlayer.Character
                                local curHrp = curChar and curChar:FindFirstChild("HumanoidRootPart")
                                if curHrp then
                                    curHrp.CFrame = CFrame.new(curHrp.Position, atmPos)
                                    Camera.CFrame = CFrame.new(Camera.CFrame.Position, atmPos)
                                end
                                
                                local tool = char:FindFirstChildOfClass("Tool")
                                if tool then tool:Activate() end
                                
                                local vu = game:GetService("VirtualUser")
                                vu:CaptureController()
                                vu:ClickButton1(Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2))
                            end)
                            task.wait(atmFarmSpd)
                        end
                        task.wait(atmCooldown)
                    end
                end
                task.wait(2)
            end
        end)
        pcall(function() game:GetService("StarterGui"):SetCore("SendNotification", {Title="ATM打劫", Text="已开启，实时锁定朝向", Duration=3}) end)
    else
        pcall(function() game:GetService("StarterGui"):SetCore("SendNotification", {Title="ATM打劫", Text="已停止", Duration=3}) end)
    end
end })

