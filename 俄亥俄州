-- 🧲 吸人页
-- =========================================================
local pullEn = false
local pullHeight = 4.5
local pullAll = false
local selectedTargets = {}
local pullDropdown = nil

local function getOtherPlayers()
    local names = {}
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LocalPlayer then
            table.insert(names, p.Name)
        end
    end
    table.sort(names)
    return names
end

TabPull:Section({ Title = "🧲 吸人设置" })
TabPull:Paragraph({ Title = "说明", Desc = "选中的玩家会被瞬间传送到你的头顶上方。为了避免踩头，高度默认在头顶 4.5 格。" })

pullDropdown = TabPull:Dropdown({
    Title = "选择吸附目标（可多选）",
    Values = getOtherPlayers(),
    Value = {},
    Multi = true,
    AllowNone = true,
    Callback = function(v)
        selectedTargets = {}
        if type(v) == "table" then
            for _, name in ipairs(v) do
                local p = Players:FindFirstChild(name)
                if p then selectedTargets[p] = true end
            end
        end
    end
})

TabPull:Button({
    Title = "🔄 刷新玩家列表",
    Callback = function()
        if pullDropdown and pullDropdown.SetValues then
            pullDropdown.SetValues(getOtherPlayers())
            pullDropdown.SetValue({})
            selectedTargets = {}
        end
    end
})

TabPull:Toggle({
    Title = "吸附全部玩家（无视列表）",
    Value = false,
    Callback = function(en)
        pullAll = en
    end
})

TabPull:Slider({
    Title = "吸附高度（头顶上方格数）",
    Value = { Min = 3, Max = 20, Default = 4.5 },
    Step = 0.1,
    Callback = function(v)
        pullHeight = v
    end
})

TabPull:Toggle({
    Title = "开启吸人",
    Value = false,
    Callback = function(en)
        pullEn = en
        if not en then
            pcall(function() game:GetService("StarterGui"):SetCore("SendNotification", {Title="吸人", Text="已停止", Duration=3}) end)
            return
        end

        pcall(function() game:GetService("StarterGui"):SetCore("SendNotification", {Title="吸人", Text="已开启，正在拉取目标", Duration=3}) end)

        task.spawn(function()
            while pullEn do
                task.wait(0.1)
                pcall(function()
                    local myChar = LocalPlayer.Character
                    local myHrp = myChar and myChar:FindFirstChild("HumanoidRootPart")
                    if not myHrp then return end
                    
                    local targetPos = myHrp.Position + Vector3.new(0, pullHeight, 0)

                    if pullAll then
                        for _, p in ipairs(Players:GetPlayers()) do
                            if p ~= LocalPlayer then
                                local tChar = p.Character
                                local tHrp = tChar and tChar:FindFirstChild("HumanoidRootPart")
                                if tHrp then
                                    tHrp.CFrame = CFrame.new(targetPos)
                                end
                            end
                        end
                    else
                        for p, _ in pairs(selectedTargets) do
                            if p and p.Parent then
                                local tChar = p.Character
                                local tHrp = tChar and tChar:FindFirstChild("HumanoidRootPart")
                                if tHrp then
                                    tHrp.CFrame = CFrame.new(targetPos)
                                end
                            end
                        end
                    end
                end)
            end
        end)
    end
})

