local aimEn, showFOV, showTrc, fovR, wallChk, aimPart = false, false, false, 150, false, "头部"
local fovCircle, tracerLine
if typeof(Drawing) == "table" and Drawing.new then
    fovCircle = Drawing.new("Circle"); fovCircle.Thickness = 2; fovCircle.Color = Color3.fromRGB(0, 140, 255); fovCircle.Filled = false; fovCircle.Visible = false
    tracerLine = Drawing.new("Line"); tracerLine.Thickness = 1; tracerLine.Color = Color3.fromRGB(0, 255, 255); tracerLine.Visible = false
end
local function getAimP(char) if aimPart == "头部" then return char:FindFirstChild("Head") elseif aimPart == "身体" then return char:FindFirstChild("UpperTorso") or char:FindFirstChild("Torso") or char:FindFirstChild("HumanoidRootPart") else return char:FindFirstChild("HumanoidRootPart") end end
local function hasLOS(tChar, tPart)
    local mChar = LocalPlayer.Character; local mHrp = mChar and mChar:FindFirstChild("HumanoidRootPart")
    if not mHrp or not tPart then return false end
    local rp = RaycastParams.new(); rp.FilterType = Enum.RaycastFilterType.Exclude; rp.FilterDescendantsInstances = {mChar, tChar}
    return workspace:Raycast(mHrp.Position, tPart.Position - mHrp.Position, rp) == nil
end
local function getClosestT()
    local cPart, sDist = nil, fovR; if not Camera then return nil end
    local scCenter = Vector2.new(Camera.ViewportSize.X/2, Camera.ViewportSize.Y/2)
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= LocalPlayer then
            local c = plr.Character; local h = c and c:FindFirstChildOfClass("Humanoid")
            if h and h.Health > 0 then
                local tP = getAimP(c)
                if tP then local sp, onScr = Camera:WorldToViewportPoint(tP.Position)
                    if onScr then local d = (Vector2.new(sp.X, sp.Y) - scCenter).Magnitude
                        if d < sDist then if wallChk then if hasLOS(c, tP) then cPart = tP; sDist = d end else cPart = tP; sDist = d end end
                    end
                end
            end
        end
    end
    return cPart
end
RunService.RenderStepped:Connect(function()
    if not Camera then return end
    local scCenter = Vector2.new(Camera.ViewportSize.X/2, Camera.ViewportSize.Y/2)
    if fovCircle then if showFOV then fovCircle.Position = scCenter; fovCircle.Radius = fovR; fovCircle.Visible = true else fovCircle.Visible = false end end
    if not aimEn then if tracerLine then tracerLine.Visible = false end return end
    local t = getClosestT()
    if t then
        Camera.CFrame = Camera.CFrame:Lerp(CFrame.new(Camera.CFrame.Position, t.Position), 0.35)
        if tracerLine and showTrc then local sp, onScr = Camera:WorldToViewportPoint(t.Position)
            if onScr then tracerLine.From = Vector2.new(Camera.ViewportSize.X/2, Camera.ViewportSize.Y); tracerLine.To = Vector2.new(sp.X, sp.Y); tracerLine.Visible = true else tracerLine.Visible = false end
        elseif tracerLine then tracerLine.Visible = false end
    else if tracerLine then tracerLine.Visible = false end end
end)
