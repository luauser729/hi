local atmEspEnabled = false
local atmTags = {}

local function doScan()
    if not atmEspEnabled then
        for obj, data in pairs(atmTags) do 
            if data.bg and data.bg.Parent then data.bg:Destroy() end
            if data.hl and data.hl.Parent then data.hl:Destroy() end
        end
        atmTags = {}
        return
    end

    local scanned = 0
    for _, obj in ipairs(workspace:GetDescendants()) do
        local n = string.lower(obj.Name)
        if obj:IsA("Model") and n == "atm" then
            if not atmTags[obj] then
                local part = obj.PrimaryPart or obj:FindFirstChildWhichIsA("BasePart")
                if part then
                    local bg = Instance.new("BillboardGui")
                    bg.Size = UDim2.new(0, 100, 0, 30); bg.StudsOffset = Vector3.new(0, 3, 0); bg.AlwaysOnTop = true; bg.Parent = part
                    local txt = Instance.new("TextLabel")
                    txt.Size = UDim2.fromScale(1, 1); txt.BackgroundTransparency = 1; txt.Text = "💰 ATM"
                    txt.TextColor3 = Color3.fromRGB(0, 255, 0); txt.TextStrokeTransparency = 0; txt.Font = Enum.Font.GothamBold; txt.TextSize = 16
                    txt.Parent = bg
                    
                    local hl = Instance.new("Highlight")
                    hl.FillColor = Color3.fromRGB(0, 255, 100)
                    hl.FillTransparency = 0.5
                    hl.OutlineColor = Color3.fromRGB(0, 255, 0)
                    hl.OutlineTransparency = 0
                    hl.Adornee = obj
                    hl.Parent = obj
                    
                    atmTags[obj] = {bg = bg, hl = hl}
                end
            end
        end
        scanned = scanned + 1
        if scanned % 500 == 0 then task.wait() end
    end
end

