TabSettings:Section({ Title = "⚙️ 界面设置" })

TabSettings:Dropdown({
    Title = "切换窗口颜色",
    Values = {"蓝色", "红色", "绿色", "黄色", "紫色", "青色", "粉色", "金色"},
    Value = "蓝色",
    Callback = function(option)
        -- 这需要 UI 库的支持，通常 WindUI 本身支持配置主题
        -- 如果是纯粹改变 UIStroke，需要遍历修改，但这里我们调用库自带的接口（如果有）
        pcall(function()
            Window:SetTheme(option) -- 假设 WindUI 支持中文主题名，如果不支持则需要映射
        end)
        
        -- 因为不确定 WindUI 的内部代码，做一个备用方案：直接暴力改窗口边框颜色
        local mainFrame = Window.UIElements and Window.UIElements.Main
        if mainFrame then
            local stroke = mainFrame:FindFirstChildOfClass("UIStroke")
            if stroke then
                if option == "蓝色" then stroke.Color = Color3.fromRGB(59, 130, 246)
                elseif option == "红色" then stroke.Color = Color3.fromRGB(230, 70, 70)
                elseif option == "绿色" then stroke.Color = Color3.fromRGB(60, 200, 120)
                elseif option == "黄色" then stroke.Color = Color3.fromRGB(240, 200, 60)
                elseif option == "紫色" then stroke.Color = Color3.fromRGB(160, 100, 255)
                elseif option == "青色" then stroke.Color = Color3.fromRGB(70, 220, 220)
                elseif option == "粉色" then stroke.Color = Color3.fromRGB(255, 100, 180)
                elseif option == "金色" then stroke.Color = Color3.fromRGB(255, 215, 0)
                end
            end
        end
    end
})

