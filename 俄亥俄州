    hbEn = en
    if hbConn then hbConn:Disconnect(); hbConn = nil end
    if en then
        hbConn = RunService.Heartbeat:Connect(function()
            if hbEn then
                for r, d in pairs(hbOrig) do
                    if not r.Parent or not r.Parent:FindFirstChildOfClass("Humanoid") or r.Parent:FindFirstChildOfClass("Humanoid").Health <= 0 then
                        if r and r.Parent then r.Size = d.Size; r.Transparency = d.Transparency; r.Color = d.Color; r.Material = d.Material end
                        hbOrig[r] = nil
                    end
                end
                for _, p in ipairs(Players:GetPlayers()) do if p ~= LocalPlayer then applyHB(p.Character) end end
            end
        end)
    else restoreHB() end
end })
