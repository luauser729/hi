local hbEn, hbSz, hbCol, hbDep = false, 10, Color3.fromRGB(255,50,50), 0.5
local hbConn, hbOrig = nil, {}
local function applyHB(c)
    if not c or c == LocalPlayer.Character then return end
    local r = c:FindFirstChild("HumanoidRootPart"); local h = c:FindFirstChildOfClass("Humanoid")
    if r and h and h.Health > 0 then
        if not hbOrig[r] then hbOrig[r] = {Size = r.Size, Transparency = r.Transparency, Color = r.Color, Material = r.Material} end
        r.Size = Vector3.new(hbSz, hbSz, hbSz); r.Color = hbCol; r.Transparency = hbDep; r.Material = Enum.Material.ForceField; r.CanCollide = false
    end
end
local function restoreHB()
    for r, d in pairs(hbOrig) do pcall(function() if r and r.Parent then r.Size = d.Size; r.Transparency = d.Transparency; r.Color = d.Color; r.Material = d.Material end end) end
    hbOrig = {}
end
